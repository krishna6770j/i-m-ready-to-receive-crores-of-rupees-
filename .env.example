# Copy to .env and fill in locally. NEVER commit .env.
#
# .env is listed in .gitignore. Do not paste these values into source code,
# into chat, or into any file other than your local .env.

# --- Trading mode ---------------------------------------------------------
# Allowed: backtest | live_signal | paper | live
# Default is "paper" if unset. "live" is NOT implemented in Phase 1 and is
# rejected by config.settings at load time.
TRADING_MODE=paper

# --- FYERS API credentials ------------------------------------------------
# Obtained from https://myapi.fyers.in/dashboard/ (create an app).
# FYERS_CLIENT_ID is the app id, typically of the form XXXXXXXXXX-100.
FYERS_CLIENT_ID=
FYERS_SECRET_KEY=
FYERS_REDIRECT_URI=

# Short-lived access token produced by the OAuth flow (scripts/fyers_login.py).
# Per FYERS' notice on the SEBI framework effective 2026-04-01, 2FA must be
# completed once every trading day and continuous refresh-token sessions are
# discontinued, so this value is expected to be re-generated each trading day.
FYERS_ACCESS_TOKEN=

# --- Paths ----------------------------------------------------------------
DATA_STORE_DIR=data_store
LOG_DIR=logs
